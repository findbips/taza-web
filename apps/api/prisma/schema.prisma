generator client { provider = "prisma-client" output = "../src/generated/prisma" }
datasource db { provider = "postgresql" }

enum Role { CUSTOMER ADMIN PARTNER }
enum OrderStatus { PENDING CONFIRMED PROCESSING SHIPPED DELIVERED CANCELLED REFUNDED }
enum PaymentMethod { COD BKASH NAGAD SSL_COMMERZ }
enum PaymentStatus { UNPAID PENDING PAID FAILED REFUNDED }
enum ReviewStatus { PENDING APPROVED REJECTED }
enum CouponType { PERCENT FIXED }

enum BatchStatus { ACTIVE HOLD EXPIRED }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  phone String?
  role Role @default(CUSTOMER)
  orders Order[]
  addresses Address[]
  reviews Review[]
  partner Partner?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id String @id @default(cuid())
  userId String
  label String @default("Home")
  recipientName String
  phone String
  addressLine String
  area String?
  city String @default("Dhaka")
  postalCode String?
  isDefault Boolean @default(false)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Partner {
  id String @id @default(cuid())
  userId String @unique
  code String @unique
  commissionRate Int @default(10)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  orders Order[]
  commissions PartnerCommission[]
  createdAt DateTime @default(now())
}

model PartnerCommission {
  id String @id @default(cuid())
  partnerId String
  orderId String @unique
  amount Int
  status String @default("PENDING")
  partner Partner @relation(fields:[partnerId],references:[id],onDelete:Cascade)
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  paidAt DateTime?
  @@index([partnerId,status])
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  category String
  shortDescription String?
  description String
  price Int
  compareAtPrice Int?
  stock Int @default(0)
  sku String @unique
  weightGrams Int?
  ingredients String?
  active Boolean @default(true)
  imageUrl String?
  images ProductImage[]
  batches ProductionBatch[]
  orderItems OrderItem[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category,active])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  url String
  alt String?
  sortOrder Int @default(0)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}

model ProductionBatch {
  id String @id @default(cuid())
  productId String
  batchCode String @unique
  producedAt DateTime
  bestBefore DateTime?
  inputWeightGrams Int?
  outputUnits Int?
  status BatchStatus @default(ACTIVE)
  notes String?
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@index([productId,status])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  userId String?
  partnerId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  partner Partner? @relation(fields:[partnerId],references:[id],onDelete:SetNull)
  customerName String
  email String
  phone String
  address String
  city String @default("Dhaka")
  postalCode String?
  subtotal Int
  deliveryFee Int @default(80)
  discount Int @default(0)
  total Int
  couponCode String?
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentReference String?
  status OrderStatus @default(PENDING)
  items OrderItem[]
  commission PartnerCommission?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([status,createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  productName String
  quantity Int
  unitPrice Int
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  type CouponType
  value Int
  minOrder Int @default(0)
  maxUses Int?
  usedCount Int @default(0)
  startsAt DateTime?
  expiresAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id String @id @default(cuid())
  productId String
  userId String
  rating Int
  title String?
  body String
  status ReviewStatus @default(PENDING)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([productId,status])
}

model NewsletterSubscriber { id String @id @default(cuid()); email String @unique; source String?; createdAt DateTime @default(now()) }
model ContactMessage { id String @id @default(cuid()); name String; email String; phone String?; message String; readAt DateTime?; createdAt DateTime @default(now()) }
